docker/downloads/
docker/s6-overlay/

# Rebrand working files (keep scripts + SVG masters only)
.rebrand/profile*
.rebrand/*.log
.rebrand/*.txt
.rebrand/*.png

# ── EAS 追加：本地构建缓存（git 未跟踪，但会进云构建 tarball）──
apps/desktop/bin-cache/
apps/desktop/src-tauri/target/
