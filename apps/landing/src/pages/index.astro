---
import Hero from "../components/Hero.astro";
import Homepage from "../Homepage";
import Layout from "../layouts/Layout.astro";
---

<Layout path="/">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Saiye",
      "url": "https://saiye.app",
      "description": "Saiye is the open-source bookmark manager for links, notes, and images. Automatically organize and tag your bookmarks with AI.",
      "applicationCategory": "Productivity",
      "operatingSystem": "Web, iOS, Android",
      "offers": [
        {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD",
          "description": "Free, self-hosted, and open source"
        }
      ],
      "featureList": [
        "AI-powered bookmark tagging",
        "Full text search",
        "Collaborative lists",
        "RSS feed integration",
        "Browser extensions",
        "Self-hosting support",
        "REST API and webhooks",
        "Dark mode"
      ],
      "screenshot": "https://saiye.app/hero.webp",
      "softwareVersion": "latest",
      "author": {
        "@type": "Organization",
        "name": "Saiye",
        "url": "https://saiye.app"
      }
    })} />
  </Fragment>
  <Hero />
  <Homepage />
</Layout>
